---
---

<header class="flex justify-center">
  <nav class="flex items-center justify-between h-[12vh] w-[80%]">
    <a href="#" class="text-3xl font-bold">
      Buzz<span class="text-(--primary-color)">Buy.</span>
    </a>
    <ul class="flex items-center gap-10">
      <li class="link link-active">
        <a href="#">HOME</a>
      </li>
      <li class="link">
        <a href="#">SHOP</a>
      </li>
      <li class="link">
        <a href="#">PAGE</a>
      </li>
      <li class="link">
        <a href="#">BLOG</a>
      </li>
      <li class="link">
        <a href="#">CONTACT</a>
      </li>
      <li class="flex gap-4">
        <a
          href="#"
          class="text-sm text-(--light-black) hover:text-(--primary-color) leading-10 text-center w-10 rounded-full hover:bg-(--secondary-color)"
        >
          <i class="fa-solid fa-magnifying-glass"></i>
        </a>
        <a
          href="#"
          class="text-sm text-(--light-black) hover:text-(--primary-color) leading-10 text-center w-10 rounded-full hover:bg-(--secondary-color)"
        >
          <i class="fa-solid fa-user"></i>
        </a>
        <a
          href="#"
          class="text-sm text-(--light-black) hover:text-(--primary-color) leading-10
          text-center w-10 rounded-full hover:bg-(--secondary-color) icon-active link-active"
        >
          <i class="fa-solid fa-shopping-bag"></i>
        </a>
      </li>
    </ul>
    <a href="#" class="hamburger">
      <i class="fa-solid fa-bars"></i>
    </a>
  </nav>
</header>

<style>
  .link {
    font-size: 0.95rem;
    color: var(--light-black);
    font-weight: 500;
  }
  .link-active,
  .link:hover {
    color: var(--primary-color);
  }
  .icon-active {
    background-color: var(--secondary-color);
  }
  .hamburger {
    font-size: 1.7rem;
    color: var(--primary-color);
    display: none;
  }
</style>
