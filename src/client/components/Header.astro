---
---

<header>
  <nav class="navbar flex container">
    <a href="#" class="logo">
      Buzz<span>Buy.</span>
    </a>
    <ul class="navlist flex">
      <li class="link link-active">
        <a href="#">HOME</a>
      </li>
      <li class="link">
        <a href="#">SHOP</a>
      </li>
      <li class="link">
        <a href="#">PAGE</a>
      </li>
      <li class="link">
        <a href="#">BLOG</a>
      </li>
      <li class="link">
        <a href="#">CONTACT</a>
      </li>
      <li class="nav-icons flex">
        <a href="#" class="icon">
          <i class="fa-solid fa-magnifying-glass"></i>
        </a>
        <a href="#" class="icon">
          <i class="fa-solid fa-user"></i>
        </a>
        <a href="#" class="icon icon-active">
          <i class="fa-solid fa-shopping-bag"></i>
        </a>
      </li>
    </ul>
    <a href="#" class="hamburger">
      <i class="fa-solid fa-bars"></i>
    </a>
  </nav>
</header>

<style>
  header {
    background-color: var(--white-color);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 99;
    box-shadow: 0px 5px 14px 0.75px rgba(36, 11, 12, 0.5);
  }
  .logo {
    font-size: 1.8rem;
    font-weight: bold;
    color: var(--light-black);
  }
  .link a {
    font-size: 0.95rem;
    color: var(--light-black);
    font-weight: 500;
    transition: 0.3s ease;
  }
  .link-active a,
  .link:hover a {
    color: var(--primary-color);
  }
  .icon-active i {
    background-color: var(--secondary-color);
    color: var(--primary-color);
  }
  .hamburger {
    font-size: 1.7rem;
    color: var(--primary-color);
    display: none;
  }
  .icon {
    font-size: 0.9rem;
    color: var(--light-black);

    width: 40px;
    height: 40px;
    text-align: center;
    line-height: 40px;
    border-radius: 50%;
  }
  .icon:hover,
  .icon-active {
    background-color: var(--secondary-color);
  }
  a {
    transition: 0.3s ease;
  }
  a:hover {
    color: var(--primary-color);
  }
  .link-active {
    color: var(--primary-color);
  }
  .navbar {
    height: 12vh;
    justify-content: space-between;
  }
  .navlist {
    gap: 2.5rem;
  }
  .nav-icons {
    gap: 0.8rem;
  }

  @media screen and (max-width: 700px) {
    .navlist {
      flex-direction: column;
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      background-color: var(--black-color);
      padding: 2rem;
      transform: translateY(-100%);
    }
    .navlist-active {
      transform: translateY(20%);
    }
    .navlist a {
      color: var(--secondary-color);
    }
    .nav-icons a {
      color: var(--primary-color);
    }
    .hamburger {
      display: block;
    }
    .container {
      max-width: 95%;
    }
  }
</style>
